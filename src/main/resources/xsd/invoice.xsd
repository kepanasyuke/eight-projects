<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:inv="urn:eight:invoice"
           targetNamespace="urn:eight:invoice"
           elementFormDefault="qualified">

    <xs:include schemaLocation="common-types.xsd"/>

    <xs:element name="invoice">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="number" type="inv:InvoiceNumber"/>
                <xs:element name="issuedAt" type="xs:date"/>
                <xs:element name="seller" type="inv:Party"/>
                <xs:element name="buyer" type="inv:Party"/>
                <xs:element name="items">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="item" type="inv:InvoiceItem" maxOccurs="100"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="total" type="inv:Money"/>
            </xs:sequence>
            <xs:attribute name="version" type="xs:positiveInteger" use="optional" default="1"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
